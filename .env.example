NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://neo4j:7687

PIPELINE_MODE=accurate
MAX_UPLOAD_MB=50
WINDOW_SIZE=3
WINDOW_STRIDE=2

RESOLUTION_THRESHOLD=0.85

# Leave empty to disable auth; set a secret string for production
API_KEY=

# Extra browser origins allowed to call the API (JSON list). The bundled UI needs none.
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
